  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A1_109">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">设备购置费〔A.1-109〕</rdfs:label>
