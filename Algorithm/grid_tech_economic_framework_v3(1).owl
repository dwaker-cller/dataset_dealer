<?xml version='1.0' encoding='utf-8'?>
<rdf:RDF xmlns:gte="https://example.org/grid-tech-economic#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="https://example.org/grid-tech-economic">
  <owl:Ontology rdf:about="https://example.org/grid-tech-economic/framework-v3">
    <rdfs:label xml:lang="zh">电网工程技术经济分析管理本体</rdfs:label>
    <owl:versionInfo xml:lang="zh">3.2 增加电网基建工程造价分析任务模板及指标关联</owl:versionInfo>
    <rdfs:comment xml:lang="zh">保留v3类与属性定义，填充电网基建工程造价数据信息化管理规范送审稿附录A.1、A.2共180条指标定义、73条计算规则和26个来源页。不是180个已去重的通用指标。增加现场造价管理阶段词表个体；不包含指标记录或真实工程数值。公式原文不自动执行，待确认事项见各个体注释及说明文件。</rdfs:comment>
    <owl:versionIRI rdf:resource="https://example.org/grid-tech-economic/framework-v3/3.2" />
  </owl:Ontology>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#GridProject">
    <rdfs:label xml:lang="zh">电网工程项目</rdfs:label>
    <rdfs:comment xml:lang="zh">整体建设任务，包含单项工程。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#IndividualEngineering">
    <rdfs:label xml:lang="zh">单项工程</rdfs:label>
    <rdfs:comment xml:lang="zh">电网工程项目内的工程组成；变电、架空线路、电缆线路工程为其子类。</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://example.org/grid-tech-economic#partOfProject" />
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#SubstationEngineering">
    <rdfs:label xml:lang="zh">变电工程</rdfs:label>
    <rdfs:comment xml:lang="zh">变电类型的单项工程。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/grid-tech-economic#IndividualEngineering" />
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#OverheadLineEngineering">
    <rdfs:label xml:lang="zh">架空线路工程</rdfs:label>
    <rdfs:comment xml:lang="zh">架空线路类型的单项工程。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/grid-tech-economic#IndividualEngineering" />
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#CableLineEngineering">
    <rdfs:label xml:lang="zh">电缆线路工程</rdfs:label>
    <rdfs:comment xml:lang="zh">电缆线路类型的单项工程。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/grid-tech-economic#IndividualEngineering" />
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#TechnicalScheme">
    <rdfs:label xml:lang="zh">工程技术方案</rdfs:label>
    <rdfs:comment xml:lang="zh">每个个体代表一个确定版本；直接对应一个项目或单项工程。</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://example.org/grid-tech-economic#schemeFor" />
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#FunctionalRequirement">
    <rdfs:label xml:lang="zh">功能要求</rdfs:label>
    <rdfs:comment xml:lang="zh">需要实现的目标及判定条件；响应不代表已经满足。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#ConstructionCondition">
    <rdfs:label xml:lang="zh">建设条件</rdfs:label>
    <rdfs:comment xml:lang="zh">地形、地质、空间等工程条件。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#SchemeComponent">
    <rdfs:label xml:lang="zh">方案技术组成</rdfs:label>
    <rdfs:comment xml:lang="zh">方案的技术组成上位概念，UML标记为抽象类；OWL本版不额外设置禁止直接实例化约束。</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://example.org/grid-tech-economic#componentOf" />
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#EquipmentMaterialConfiguration">
    <rdfs:label xml:lang="zh">设备与材料配置</rdfs:label>
    <rdfs:comment xml:lang="zh">方案的设备与材料类别及选型。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/grid-tech-economic#SchemeComponent" />
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#SystemLayout">
    <rdfs:label xml:lang="zh">系统与布置方案</rdfs:label>
    <rdfs:comment xml:lang="zh">系统连接、组织及布置形式。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/grid-tech-economic#SchemeComponent" />
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#EngineeringMeasure">
    <rdfs:label xml:lang="zh">工程技术措施</rdfs:label>
    <rdfs:comment xml:lang="zh">地基处理、敷设及施工等技术措施。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/grid-tech-economic#SchemeComponent" />
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#IndicatorDefinition">
    <rdfs:label xml:lang="zh">指标定义</rdfs:label>
    <rdfs:comment xml:lang="zh">指标含义、口径、分类、标准单位和适用范围；不同口径不可仅凭名称合并。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#ManagementStage">
    <rdfs:label xml:lang="zh">工程管理阶段</rdfs:label>
    <rdfs:comment xml:lang="zh">工程管理阶段词表；指标适用阶段、方案形成阶段、资料所属阶段、任务开展阶段分别关联。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#CalculationRule">
    <rdfs:label xml:lang="zh">计算规则</rdfs:label>
    <rdfs:comment xml:lang="zh">公式、输入定义、统计口径及适用条件；表达式本身不自动执行。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#EvidenceSource">
    <rdfs:label xml:lang="zh">依据资料</rdfs:label>
    <rdfs:comment xml:lang="zh">标准、设计文件、批复、预算、结算或分析资料的具体版本；页码定位另记。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#AnalysisTask">
    <rdfs:label xml:lang="zh">分析任务</rdfs:label>
    <rdfs:comment xml:lang="zh">具有分析目的、评价对象、方法和准则的技术经济分析活动。分析类型描述其业务类别；本版不将类型名称实例化为具体执行任务。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#AnalysisMethod">
    <rdfs:label xml:lang="zh">分析方法</rdfs:label>
    <rdfs:comment xml:lang="zh">评价方法及适用条件和步骤。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#EvaluationCriterion">
    <rdfs:label xml:lang="zh">评价准则</rdfs:label>
    <rdfs:comment xml:lang="zh">可行性、可比性及优选准则。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#AnalysisConclusion">
    <rdfs:label xml:lang="zh">分析结论</rdfs:label>
    <rdfs:comment xml:lang="zh">分析形成的判断及其适用范围和不确定性；涉及指标关系不表示指标定义本身是实证证据。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#ReviewRecord">
    <rdfs:label xml:lang="zh">审核记录</rdfs:label>
    <rdfs:comment xml:lang="zh">对分析结论的审核意见。</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://example.org/grid-tech-economic#reviewedBy" />
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#DecisionRecord">
    <rdfs:label xml:lang="zh">决策记录</rdfs:label>
    <rdfs:comment xml:lang="zh">依据分析结论作出的选用、调整或其他决策。</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://example.org/grid-tech-economic#decidedBy" />
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/grid-tech-economic#ResponsibleParty">
    <rdfs:label xml:lang="zh">责任主体</rdfs:label>
    <rdfs:comment xml:lang="zh">承担分析、审核或决策的人员或组织。</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#hasEngineering">
    <rdfs:label xml:lang="zh">包含单项工程</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#GridProject" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#IndividualEngineering" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#partOfProject">
    <rdfs:label xml:lang="zh">所属项目</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#IndividualEngineering" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#GridProject" />
    <owl:inverseOf rdf:resource="https://example.org/grid-tech-economic#hasEngineering" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#schemeFor">
    <rdfs:label xml:lang="zh">方案对应工程</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#TechnicalScheme" />
    <rdfs:range>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/grid-tech-economic#GridProject" />
          <rdf:Description rdf:about="https://example.org/grid-tech-economic#IndividualEngineering" />
        </owl:unionOf>
      </owl:Class>
    </rdfs:range>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#hasSubScheme">
    <rdfs:label xml:lang="zh">包含子方案</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#TechnicalScheme" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#TechnicalScheme" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#revises">
    <rdfs:label xml:lang="zh">修订自</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#TechnicalScheme" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#TechnicalScheme" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#hasRequirement">
    <rdfs:label xml:lang="zh">具有功能要求</rdfs:label>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/grid-tech-economic#GridProject" />
          <rdf:Description rdf:about="https://example.org/grid-tech-economic#IndividualEngineering" />
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#FunctionalRequirement" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#hasCondition">
    <rdfs:label xml:lang="zh">具有建设条件</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#IndividualEngineering" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#ConstructionCondition" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#respondsTo">
    <rdfs:label xml:lang="zh">响应功能要求</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#TechnicalScheme" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#FunctionalRequirement" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#considersCondition">
    <rdfs:label xml:lang="zh">考虑建设条件</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#TechnicalScheme" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#ConstructionCondition" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#hasComponent">
    <rdfs:label xml:lang="zh">由其构成</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#TechnicalScheme" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#SchemeComponent" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#componentOf">
    <rdfs:label xml:lang="zh">组成所属方案</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#SchemeComponent" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#TechnicalScheme" />
    <owl:inverseOf rdf:resource="https://example.org/grid-tech-economic#hasComponent" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#formedAtStage">
    <rdfs:label xml:lang="zh">方案形成阶段</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#TechnicalScheme" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#ManagementStage" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#sourceStage">
    <rdfs:label xml:lang="zh">资料业务所属阶段</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#EvidenceSource" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#ManagementStage" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#hasRule">
    <rdfs:label xml:lang="zh">规定计算方式</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#CalculationRule" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#definitionBasis">
    <rdfs:label xml:lang="zh">定义依据</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#EvidenceSource" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#ruleBasis">
    <rdfs:label xml:lang="zh">规则依据</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#CalculationRule" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#EvidenceSource" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#evaluates">
    <rdfs:label xml:lang="zh">评价或比较</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#AnalysisTask" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#TechnicalScheme" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#taskStage">
    <rdfs:label xml:lang="zh">任务开展阶段</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#AnalysisTask" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#ManagementStage" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#usesMethod">
    <rdfs:label xml:lang="zh">采用分析方法</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#AnalysisTask" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#AnalysisMethod" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#usesCriterion">
    <rdfs:label xml:lang="zh">按照评价准则</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#AnalysisTask" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#EvaluationCriterion" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#hasConclusion">
    <rdfs:label xml:lang="zh">形成分析结论</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#AnalysisTask" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#AnalysisConclusion" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#hasReview">
    <rdfs:label xml:lang="zh">接受审核</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#AnalysisConclusion" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#ReviewRecord" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#basedOnConclusion">
    <rdfs:label xml:lang="zh">决策依据结论</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#DecisionRecord" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#AnalysisConclusion" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#concernsScheme">
    <rdfs:label xml:lang="zh">选用或要求调整</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#DecisionRecord" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#TechnicalScheme" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#undertakenBy">
    <rdfs:label xml:lang="zh">分析承担主体</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#AnalysisTask" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#ResponsibleParty" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#reviewedBy">
    <rdfs:label xml:lang="zh">审核主体</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#ReviewRecord" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#ResponsibleParty" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/grid-tech-economic#decidedBy">
    <rdfs:label xml:lang="zh">决策主体</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/grid-tech-economic#DecisionRecord" />
    <rdfs:range rdf:resource="https://example.org/grid-tech-economic#ResponsibleParty" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/grid-tech-economic#identifier">
    <rdfs:label xml:lang="zh">编码</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:comment xml:lang="zh">用于项目编码、工程编码、方案编号、指标编码、阶段编码和任务编号。</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/grid-tech-economic#name">
    <rdfs:label xml:lang="zh">名称</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:comment xml:lang="zh">用于各类名称，包括指标规范名称。</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/grid-tech-economic#description">
    <rdfs:label xml:lang="zh">说明</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:comment xml:lang="zh">用于方案技术组成的技术说明等一般说明。</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/grid-tech-economic#version">
    <rdfs:label xml:lang="zh">版本</rdfs:label>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/grid-tech-economic#TechnicalScheme" />
          <rdf:Description rdf:about="https://example.org/grid-tech-economic#EvidenceSource" />
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:comment xml:lang="zh">方案版本、资料版本；不表示指标数据版本。</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/grid-tech-economic#status">
