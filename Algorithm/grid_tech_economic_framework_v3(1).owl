  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A2_019">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">全口径预算及时率〔A.2-019〕</rdfs:label>
    <gte:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prop_qkjysjsl</gte:identifier>
    <gte:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">全口径预算及时率</gte:name>
    <gte:definitionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">通过对特定时期内在开工前完成基于施工图设计及工程招标结果的全口径预算编审的工程进行统计，计算其与开工工程总数的比值，反映全口径预算及时实施情况的指标。</gte:definitionText>
    <gte:indicatorCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">管理指标</gte:indicatorCategory>
    <gte:standardUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">%</gte:standardUnit>
    <gte:applicability rdf:datatype="http://www.w3.org/2001/XMLSchema#string">工程类型（原文）：未列工程类型列；层级（原文）：单项工程；阶段（原文）：全口径预算管理阶段</gte:applicability>
    <rdfs:comment xml:lang="zh">来源：附录A.2第19项；PDF第42页/印刷第39页。原文数据单位及精度：%，保留两位小数。原文计算式：全口径预算及时率=count（（开工时间-全口径预算评审完成时间）&gt;0）/开工工程总数×100%。</rdfs:comment>
    <gte:definitionBasis rdf:resource="https://example.org/grid-tech-economic#SpecDraft_Page_42" />
    <gte:applicableStage rdf:resource="https://example.org/grid-tech-economic#FullScopeBudget" />
    <gte:hasRule rdf:resource="https://example.org/grid-tech-economic#SpecDraft_A2_019_Rule" />
