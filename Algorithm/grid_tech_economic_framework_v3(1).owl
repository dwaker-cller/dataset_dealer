  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A1_125_Rule">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#CalculationRule" />
    <rdfs:label xml:lang="zh">安装折单（三相）长度计算规则〔A.1-125〕</rdfs:label>
    <gte:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">安装折单（三相）长度计算规则</gte:name>
    <gte:expression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">折单长度=单回路长度×1+双回路长度×2+三回路长度×3+四回路长度×4</gte:expression>
    <gte:ruleBasis rdf:resource="https://example.org/grid-tech-economic#SpecDraft_Page_36" />
    <gte:inputDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">原式右端（含输入名称与口径）：单回路长度×1+双回路长度×2+三回路长度×3+四回路长度×4；仅对同工程类型下名称完全一致的完整运算项建立输入指标链接；其余名称、阶段、审前审后及集合限定待核对。</gte:inputDefinition>
    <gte:applicability rdf:datatype="http://www.w3.org/2001/XMLSchema#string">来源条目A.1-125；工程类型：陆上电缆输电线路工程；层级：单项工程。遵循原定义及单位口径；除法需分母非零。</gte:applicability>
