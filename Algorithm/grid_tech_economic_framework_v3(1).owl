  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A1_011">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">施工过程造价咨询及竣工结算审核费〔A.1-011〕</rdfs:label>
    <gte:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cost_sggczjzxjjgjsshf</gte:identifier>
    <gte:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">施工过程造价咨询及竣工结算审核费</gte:name>
    <gte:definitionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">施工过程造价咨询及竣工结算审核费是指依据国家有关法律、法规，根据工程合同和建设资料，项目法人单位组织工程造价专业人员或委托具有相关资质的咨询机构，自工程开工至竣工开展的施工过程造价咨询以及工程竣工结算审核所发生的费用。</gte:definitionText>
    <gte:indicatorCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">固有数据指标</gte:indicatorCategory>
    <gte:standardUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">元</gte:standardUnit>
    <gte:applicability rdf:datatype="http://www.w3.org/2001/XMLSchema#string">工程类型（原文）：变电站工程；层级（原文）：单项工程；阶段（原文）：初步设计/建安预算及招投标/全口径预算/工程结算管理阶段</gte:applicability>
    <rdfs:comment xml:lang="zh">来源：附录A.1第11项；PDF第18页/印刷第15页。原文数据单位及精度：元，取整。原文计算式：/。</rdfs:comment>
