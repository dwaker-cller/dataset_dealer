  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A1_013">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">特殊项目费用〔A.1-013〕</rdfs:label>
