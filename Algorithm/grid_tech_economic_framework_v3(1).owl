  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A1_110">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">其他费用〔A.1-110〕</rdfs:label>
    <gte:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cost_qtf</gte:identifier>
    <gte:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">其他费用</gte:name>
    <gte:definitionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">其他费用是指为完成工程项目建设所必需的，但不属于建筑工程费、安装工程费、设备购置费、基本预备费的其他相关费用。包括建设场地征用及清理费、项目建设管理费、项目建设技术服务费、生产准备费、大件运输措施费、专业爆破服务费等。</gte:definitionText>
    <gte:indicatorCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">固有数据指标</gte:indicatorCategory>
    <gte:standardUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">元</gte:standardUnit>
    <gte:applicability rdf:datatype="http://www.w3.org/2001/XMLSchema#string">工程类型（原文）：陆上电缆输电线路工程；层级（原文）：单项工程；阶段（原文）：初步设计/建安预算及招投标/全口径预算/工程结算管理阶段</gte:applicability>
    <rdfs:comment xml:lang="zh">来源：附录A.1第110项；PDF第33页/印刷第30页。原文数据单位及精度：元，取整。原文计算式：/。</rdfs:comment>
    <gte:definitionBasis rdf:resource="https://example.org/grid-tech-economic#SpecDraft_Page_33" />
    <gte:applicableStage rdf:resource="https://example.org/grid-tech-economic#PreliminaryDesign" />
