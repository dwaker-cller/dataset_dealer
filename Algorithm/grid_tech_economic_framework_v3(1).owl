    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">签约合同价〔A.1-144〕</rdfs:label>
    <gte:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fee_qyhtj</gte:identifier>
    <gte:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">签约合同价</gte:name>
    <gte:definitionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">发包人和承包人在合同协议书中确定的总金额，包括分部分项工程费、承包人采购设备费、措施项目费、其他项目费、增值税的合同总金额。</gte:definitionText>
    <gte:indicatorCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">固有数据指标</gte:indicatorCategory>
    <gte:standardUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">元</gte:standardUnit>
    <gte:applicability rdf:datatype="http://www.w3.org/2001/XMLSchema#string">工程类型（原文）：陆上电缆输电线路工程；层级（原文）：单项工程；阶段（原文）：初步设计/建安预算及招投标/全口径预算/工程结算管理阶段</gte:applicability>
    <rdfs:comment xml:lang="zh">来源：附录A.1第144项；PDF第38页/印刷第35页。原文数据单位及精度：元，保留两位小数。原文计算式：/。</rdfs:comment>
    <gte:definitionBasis rdf:resource="https://example.org/grid-tech-economic#SpecDraft_Page_38" />
