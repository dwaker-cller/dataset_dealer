  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A2_020">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">设计变更金额比重〔A.2-020〕</rdfs:label>
    <gte:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rat_sjbgjebz</gte:identifier>
