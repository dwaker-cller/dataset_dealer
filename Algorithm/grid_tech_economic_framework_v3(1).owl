  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A1_009">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">初步设计文件评审费〔A.1-009〕</rdfs:label>
    <gte:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cost_cbsjpsf</gte:identifier>
    <gte:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">初步设计文件评审费</gte:name>
    <gte:definitionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">初步设计文件评审费是指项目法人委托有资质的咨询机构依据法律、法规和相关标准，对初步设计方案的安全性、可靠性、先进性和经济性进行全面评审并提出评审报告所发生的费用。</gte:definitionText>
