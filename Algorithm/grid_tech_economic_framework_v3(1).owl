  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A1_012">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">生产准备费〔A.1-012〕</rdfs:label>
    <gte:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cost_sczbf</gte:identifier>
    <gte:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">生产准备费</gte:name>
    <gte:definitionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">生产准备费是指为保证工程竣工验收合格后能够正常投产运行提供技术保证和资源配备所发生的费用。包括管理车辆购置费、工器具及办公家具购置费、生产职工培训及提前进厂费。</gte:definitionText>
