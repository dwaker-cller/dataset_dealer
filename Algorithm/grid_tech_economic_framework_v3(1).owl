  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A2_015">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">招标工程量清单编制准确率〔A.2-015〕</rdfs:label>
    <gte:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prop_zbgclqdbzzql</gte:identifier>
    <gte:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">招标工程量清单编制准确率</gte:name>
    <gte:definitionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">通过对比招标工程量清单的审前审后的清单项数，统计招标工程量清单的缺项、漏项、错项以及超范围项等问题项数，计算无问题项数与招标工程量清单总项数的比值，反映招标工程量清单编制准确性的指标。</gte:definitionText>
    <gte:indicatorCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">管理指标</gte:indicatorCategory>
    <gte:standardUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">%</gte:standardUnit>
    <gte:applicability rdf:datatype="http://www.w3.org/2001/XMLSchema#string">工程类型（原文）：未列工程类型列；层级（原文）：单项工程；阶段（原文）：建安预算及招投标管理阶段</gte:applicability>
    <rdfs:comment xml:lang="zh">来源：附录A.2第15项；PDF第41页/印刷第38页。原文数据单位及精度：%，保留两位小数。原文计算式：招标工程量清单编制准确率=1-清单问题项数/送审招标工程量清单总项数×100%。</rdfs:comment>
    <gte:definitionBasis rdf:resource="https://example.org/grid-tech-economic#SpecDraft_Page_41" />
    <gte:applicableStage rdf:resource="https://example.org/grid-tech-economic#ConstructionBudgetTender" />
    <gte:hasRule rdf:resource="https://example.org/grid-tech-economic#SpecDraft_A2_015_Rule" />
    <rdfs:comment xml:lang="zh">待确认/表达边界：1-比值×100%的括号及百分数表达待核对，未改写。</rdfs:comment>
    <rdfs:comment xml:lang="zh">待确认/表达边界：部分或全部公式输入未结构化绑定；见规则输入变量及口径。</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A2_015_Rule">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#CalculationRule" />
