  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A1_005">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">设备购置费〔A.1-005〕</rdfs:label>
    <gte:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cost_sbgzf</gte:identifier>
