  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A1_059">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">未完工程预估费用占概算比例〔A.1-059〕</rdfs:label>
    <gte:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rat_wwgcygfyzgsbl</gte:identifier>
    <gte:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">未完工程预估费用占概算比例</gte:name>
    <gte:definitionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">指的是在工程项目实施过程中，对于尚未完成的部分工程，根据当前施工进度、材料价格、人工费用等因素，预估所需完成该部分工程所需的费用与项目总概算之间的比值。</gte:definitionText>
    <gte:indicatorCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">固有数据指标</gte:indicatorCategory>
    <gte:standardUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">%</gte:standardUnit>
    <gte:applicability rdf:datatype="http://www.w3.org/2001/XMLSchema#string">工程类型（原文）：变电站工程；层级（原文）：单项工程；阶段（原文）：初步设计/建安预算及招投标/全口径预算/工程结算管理阶段</gte:applicability>
    <rdfs:comment xml:lang="zh">来源：附录A.1第59项；PDF第25页/印刷第22页。原文数据单位及精度：%，保留两位小数。原文计算式：未完工程预估费用占概算比例=未完工程预估费用/概算×100%。</rdfs:comment>
    <gte:definitionBasis rdf:resource="https://example.org/grid-tech-economic#SpecDraft_Page_25" />
    <gte:applicableStage rdf:resource="https://example.org/grid-tech-economic#PreliminaryDesign" />
    <gte:applicableStage rdf:resource="https://example.org/grid-tech-economic#ConstructionBudgetTender" />
    <gte:applicableStage rdf:resource="https://example.org/grid-tech-economic#FullScopeBudget" />
    <gte:applicableStage rdf:resource="https://example.org/grid-tech-economic#EngineeringSettlement" />
    <gte:hasRule rdf:resource="https://example.org/grid-tech-economic#SpecDraft_A1_059_Rule" />
    <rdfs:comment xml:lang="zh">待确认/表达边界：部分或全部公式输入未结构化绑定；见规则输入变量及口径。</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A1_059_Rule">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#CalculationRule" />
    <rdfs:label xml:lang="zh">未完工程预估费用占概算比例计算规则〔A.1-059〕</rdfs:label>
    <gte:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">未完工程预估费用占概算比例计算规则</gte:name>
    <gte:expression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">未完工程预估费用占概算比例=未完工程预估费用/概算×100%</gte:expression>
    <gte:ruleBasis rdf:resource="https://example.org/grid-tech-economic#SpecDraft_Page_25" />
    <gte:inputDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">原式右端（含输入名称与口径）：未完工程预估费用/概算×100%；仅对同工程类型下名称完全一致的完整运算项建立输入指标链接；其余名称、阶段、审前审后及集合限定待核对。</gte:inputDefinition>
    <gte:applicability rdf:datatype="http://www.w3.org/2001/XMLSchema#string">来源条目A.1-59；工程类型：变电站工程；层级：单项工程。遵循原定义及单位口径；除法需分母非零。</gte:applicability>
    <rdfs:comment xml:lang="zh">输入指标链接为本次整理映射，非规范给出的显式三元组。未完成绑定的输入片段：未完工程预估费用；概算</rdfs:comment>
  </owl:NamedIndividual>
