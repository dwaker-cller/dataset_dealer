  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A2_014">
    <rdf:type rdf:resource="https://example.org/grid-tech-economic#IndicatorDefinition" />
    <rdfs:label xml:lang="zh">建安预算及时率〔A.2-014〕</rdfs:label>
    <gte:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prop_jaysjsl</gte:identifier>
    <gte:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">建安预算及时率</gte:name>
    <gte:definitionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">通过对特定时期内在施工招标前完成满足招标深度要求的建安预算编审的工程进行统计，计算其与施工招标工程总数的比值，反映建安预算及时实施情况的指标。</gte:definitionText>
    <gte:indicatorCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">管理指标</gte:indicatorCategory>
    <gte:standardUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">%</gte:standardUnit>
    <gte:applicability rdf:datatype="http://www.w3.org/2001/XMLSchema#string">工程类型（原文）：未列工程类型列；层级（原文）：单项工程；阶段（原文）：建安预算及招投标管理阶段</gte:applicability>
    <rdfs:comment xml:lang="zh">来源：附录A.2第14项；PDF第41页/印刷第38页。原文数据单位及精度：%，保留两位小数。原文计算式：建安预算及时率=count（（施工招标时间-建安预算评审完成时间）&gt;0）/施工招标工程总数×100%。</rdfs:comment>
    <gte:definitionBasis rdf:resource="https://example.org/grid-tech-economic#SpecDraft_Page_41" />
    <gte:applicableStage rdf:resource="https://example.org/grid-tech-economic#ConstructionBudgetTender" />
    <gte:hasRule rdf:resource="https://example.org/grid-tech-economic#SpecDraft_A2_014_Rule" />
    <rdfs:comment xml:lang="zh">待确认/表达边界：需要统计时段与工程集合边界；表中层级不能完整表达该统计对象。</rdfs:comment>
    <rdfs:comment xml:lang="zh">待确认/表达边界：部分或全部公式输入未结构化绑定；见规则输入变量及口径。</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/grid-tech-economic#SpecDraft_A2_014_Rule">
